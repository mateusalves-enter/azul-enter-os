    classDef law fill:#fff7ed,stroke:#b45309,color:#7c2d12;
    classDef fim fill:#f0fdf4,stroke:#059669,stroke-width:1.5px,color:#065f46;

    class Q_TIT,Q_RESP,EXTRA,CONTR,Q_FAZ,Q_DATA,ACRES,Q_CUMPR,Q_RITO,CONF dec;
    class READ,USE_TIT,USE_LEI,PRINC,EX_MAT,EX_MOR,CT_TERMO,CT_CIT,FAZ,REG_ANT,REG_NOV,REG_SEG,CORR,JUROS,ACRES_S,CUMPR,JEC,VC,HON,DESC,TOTAL,MEM act;
    class START,FIM fim;
